# 服务配置
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# 存储路径（相对项目根目录）
STORAGE_DIR=storage

# Provider 选择：mock | dashscope（OpenAI 兼容，DeepSeek 同样可用）
LLM_PROVIDER=mock
# 文生图: mock(纯色占位) | dashscope(通义万相 wanx2.1-t2i-turbo,真实 AI 图,复用 LLM_API_KEY)
IMAGE_PROVIDER=mock
# 通义万相文生图模型: wanx2.1-t2i-turbo / wanx2.1-t2i-plus / wanx-v1
IMAGE_MODEL=wanx2.1-t2i-turbo
VOICE_PROVIDER=mock
# TTS 模型/音色: qwen-audio-3.0-tts-flash + longanhuan_v3.6(中文女声)
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
# TTS 目标语言(BCP-47):zh-CN(中文普通话,默认) / en-US / ja-JP
# LLM 在 storyboard 阶段会按此语言生成 voiceover 文本
TTS_LANGUAGE=zh-CN
# 背景音乐: mock(单一正弦波) | ambient(程序化 ambient pad 和弦)
MUSIC_PROVIDER=mock
# 图生视频(I2V): mock(伪 Ken Burns,本地测试,无连续动作) | dashscope(通义万相 wan2.6-i2v-flash,真实连续动作)
# 切换到 dashscope 后,每镜会先文生图→再用图片作首帧生成 5s 动态片段,6×5s=30s 达标
I2V_PROVIDER=mock
# 通义万相图生视频模型: wan2.6-i2v-flash(推荐,2-15s+720P/1080P) / wan2.5-i2v-preview(支持自动音频) / wanx2.1-i2v-turbo
I2V_MODEL=wan2.6-i2v-flash

# 云端 ComfyUI Workflow 执行层(MiniMax H3 T2V/I2V/R2V 官方模板)
# API Key 从 https://platform.comfy.org/profile/api-keys 获取,仅存环境变量,禁止写入前端/数据库/Git
COMFY_API_KEY=
COMFY_BASE_URL=https://cloud.comfy.org

# MiniMax H3 官方直连(V2 API,pay-as-you-go 按秒计费,768P $0.08/s / 2K $0.13/s)
# Key 从平台 Account Management > API Keys 获取;国际站 https://api.minimax.io / 国内站 https://api.minimax.cn
MINIMAX_API_KEY=
MINIMAX_VIDEO_MODEL=MiniMax-H3
MINIMAX_BASE_URL=https://api.minimax.io

# 图生视频 Provider: qwen | minimax(H3 直连) | comfy(H3 官方 Workflow)
VIDEO_MODEL_PROVIDER=qwen

# LLM 连接(OpenAI 兼容接口)
# DashScope: https://dashscope.aliyuncs.com/compatible-mode/v1  模型: qwen-plus / qwen-max / qwen-turbo
# DeepSeek:  https://api.deepseek.com/v1                       模型: deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 兼容旧字段（可留空，LLM_API_KEY 优先）
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 视频输出配置(9:16 竖屏,开发用 720×1280,可调 1080×1920)
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=24
TRANSITION_DURATION=0.4
BGM_VOLUME=0.20
SUBTITLE_FONT_PATH=C:/Windows/Fonts/msyh.ttc
SUBTITLE_FONT_SIZE=42

# 内容合规预审(Compliance Agent)
# 开启=脚本生成后做规则+LLM 合规检查,不通过自动修订并复检,耗尽则进入人工审核
# 关闭=回退到原 Pipeline 顺序(不审核直接生成分镜/素材)
COMPLIANCE_CHECK_ENABLED=true
# 合规不通过时的最大自动修订次数(耗尽后进入 HUMAN_REVIEW)
COMPLIANCE_MAX_REVISIONS=2
# 审计日志落盘开关(storage/audit/compliance_audit.jsonl)
COMPLIANCE_AUDIT_ENABLED=true
# review(边界)时是否阻断:true=进入人工审核不生成;false=打标后继续生成草稿
COMPLIANCE_HALT_ON_REVIEW=false

# JWT 鉴权
JWT_SECRET=videoforge-dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# CORS 允许来源(逗号分隔,空则允许全部)
CORS_ORIGINS=http://localhost:5173
